{
  "name": "ossuary",
  "version": "4.0.0",
  "private": true,
  "description": "MIMEI — a quiet desk for learning Roblox Luau from nothing (the package keeps its old name, like the store)",
  "scripts": {
    "serve": "./serve.sh",
    "test": "npx playwright test",
    "test:headed": "npx playwright test --headed",
    "report": "npx playwright show-report",
    "smoke": "python3 tools/browsercheck.py",
    "assets": "python3 tools/assets.py",
    "lint:content": "python3 tools/lint_lessons.py",
    "lint:css": "python3 tools/lint_css.py",
    "shots": "python3 tools/shots.py"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1"
  }
}
